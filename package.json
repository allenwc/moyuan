{
  "name": "moyuan",
  "private": true,
  "version": "0.0.0",
  "description": "墨缘 — 小说人物关系图谱（H5 + 原生 weapp）",
  "workspaces": [
    "packages/*",
    "cli",
    "h5",
    "cloudfunctions/api"
  ],
  "scripts": {
    "dev:h5": "npm run dev -w @moyuan/h5",
    "build:h5": "npm run build -w @moyuan/h5",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx cloudfunctions/api/src/server.ts",
    "dev:weapp": "node weapp/scripts/bundle-core.mjs",
    "build:weapp": "node weapp/scripts/bundle-core.mjs",
    "dev": "npm run dev:h5",
    "build": "npm run build:h5",
    "lint": "eslint h5/src packages cloudfunctions/api/src cli",
    "check": "npm run build -w @moyuan/h5 --if-present; tsc -p h5 --noEmit",
    "cli": "tsx cli/src/index.ts",
    "bundle:weapp": "node weapp/scripts/bundle-core.mjs"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.6.3",
    "@moyuan/core": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@hono/node-server": "^2.0.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.15.30",
    "esbuild": "^0.25.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1"
  }
}
