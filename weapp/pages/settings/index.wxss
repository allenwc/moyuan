.settings {
  min-height: 100vh;
  background: var(--paper-soft);
  padding: 0 32rpx 120rpx;
  box-sizing: border-box;
}

.status-pad {
  background: var(--paper);
}

.hd {
  padding: 24rpx 0 36rpx;
}

.eyebrow {
  font-family: "Cormorant Garamond", "Noto Serif SC", Georgia, serif;
  font-size: 20rpx;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.title {
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
}

.card {
  margin-bottom: 24rpx;
  padding: 8rpx 28rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(31, 27, 22, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.k {
  font-size: 26rpx;
}

.v {
  font-size: 28rpx;
  color: var(--ink);
  max-width: 60%;
  text-align: right;
  word-break: break-all;
}

.card-title {
  padding: 20rpx 0 8rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.hint {
  font-size: 24rpx;
  line-height: 1.6;
  padding-bottom: 24rpx;
}

.bind-btn {
  width: 100%;
  margin-bottom: 24rpx;
}

.bound {
  padding: 16rpx 0 24rpx;
  color: var(--moss);
  font-size: 28rpx;
}

.api-key-box {
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: rgba(31, 27, 22, 0.04);
  color: var(--ink);
  font-size: 24rpx;
  line-height: 1.7;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
    "Liberation Mono", "Courier New", monospace;
  word-break: break-all;
}

.api-key-actions {
  display: flex;
  gap: 16rpx;
  padding-bottom: 24rpx;
}

.api-key-btn {
  flex: 1;
  text-align: center;
}

.btn-secondary {
  padding: 22rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(31, 27, 22, 0.14);
  color: var(--ink);
  background: rgba(255, 255, 255, 0.72);
}

.menu-item {
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--ink);
}

.menu-item--danger {
  color: var(--vermillion);
}
