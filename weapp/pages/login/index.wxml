<view class="login-page safe-top">
  <view class="login-card">
    <view class="login-header">
      <text class="login-brand">墨缘</text>
      <text class="login-subtitle">小说人物关系图谱</text>
    </view>

    <view class="login-field">
      <text class="login-label">用户名</text>
      <input
        class="login-input {{fieldError.username ? 'login-input--error' : ''}}"
        value="{{email}}"
        maxlength="64"
        placeholder="输入用户名…"
        placeholder-class="ph"
        bindinput="onEmail"
        bindconfirm="onLogin"
      />
      <text wx:if="{{fieldError.username}}" class="login-field-error">{{fieldError.username}}</text>
    </view>

    <view class="login-field">
      <text class="login-label">密码</text>
      <view class="login-input-wrap">
        <input
          class="login-input login-input--password {{fieldError.password ? 'login-input--error' : ''}}"
          password="{{!showPassword}}"
          value="{{password}}"
          maxlength="64"
          placeholder="输入登录密码…"
          placeholder-class="ph"
          bindinput="onPassword"
          bindconfirm="onLogin"
        />
        <view class="login-pwd-toggle" bindtap="togglePwd">{{showPassword ? '隐藏' : '显示'}}</view>
      </view>
      <text wx:if="{{fieldError.password}}" class="login-field-error">{{fieldError.password}}</text>
    </view>

    <view
      class="login-btn login-btn--primary {{busy ? 'login-btn--busy' : ''}}"
      bindtap="onLogin"
    >{{busy ? '登录中…' : '登录'}}</view>

    <!-- 微信一键登录 -->
    <view class="login-divider">
      <view class="login-divider-line"></view>
      <text class="login-divider-text">或</text>
      <view class="login-divider-line"></view>
    </view>
    <view
      class="login-btn login-btn--wechat {{wechatBusy ? 'login-btn--busy' : ''}}"
      bindtap="onWechatLogin"
    >{{wechatBusy ? '登录中…' : '微信一键登录'}}</view>

    <view class="login-footer">
      <text class="login-footer-text">使用 CloudBase 邮箱账号登录，数据隔离存储。</text>
    </view>
  </view>
</view>
