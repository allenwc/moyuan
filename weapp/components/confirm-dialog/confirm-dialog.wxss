.dlg-root {
  position: fixed;
  inset: 0;
  z-index: 10050;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  font-family: "Noto Sans SC", system-ui, "PingFang SC", sans-serif;
}

.dlg-mask {
  position: absolute;
  inset: 0;
  background: rgba(31, 27, 22, 0.4);
}

.dlg-card {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  background: #faf6ec;
  border: 1rpx solid rgba(31, 27, 22, 0.12);
  border-radius: 8rpx;
  overflow: hidden;
}

.dlg-body {
  padding: 40rpx 40rpx 32rpx;
}

.dlg-title {
  font-family: "Noto Serif SC", "Cormorant Garamond", "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f1b16;
}

.dlg-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.dlg-actions {
  display: flex;
  border-top: 1rpx solid rgba(31, 27, 22, 0.1);
}

.dlg-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6b6359;
}

.dlg-btn--danger {
  color: #a8322d;
  font-weight: 600;
}

.dlg-btn--default {
  color: #1f1b16;
  font-weight: 600;
}

.dlg-sep {
  width: 1rpx;
  background: rgba(31, 27, 22, 0.1);
}
