.card {
  display: flex;
  overflow: hidden;
  background: #faf6ec;
  border: 1rpx solid rgba(31, 27, 22, 0.1);
  border-radius: 8rpx;
  box-shadow: 0 2rpx 0 rgba(31, 27, 22, 0.04),
    0 16rpx 48rpx -24rpx rgba(31, 27, 22, 0.18);
  margin-bottom: 24rpx;
  font-family: "Noto Sans SC", system-ui, "PingFang SC", sans-serif;
}

.spine {
  width: 140rpx;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx;
  box-sizing: border-box;
}

.spine--cover {
  /* 有封面时保证 2:3 书封完整展示（防矮卡片裁切） */
  min-height: 230rpx;
}

.spine-cover {
  /* 2:3 书封比例，居中展示，不再铺满拉伸（避免裁切） */
  width: 116rpx;
  height: 174rpx;
  margin: auto;
  box-shadow: 0 2rpx 8rpx rgba(31, 27, 22, 0.18);
}

.spine-vol {
  font-family: "Cormorant Garamond", "Noto Serif SC", Georgia, serif;
  font-size: 18rpx;
  letter-spacing: 0.16em;
  opacity: 0.7;
  text-transform: uppercase;
}

.spine-num {
  font-family: "Cormorant Garamond", "Noto Serif SC", Georgia, serif;
  font-size: 32rpx;
  font-style: italic;
  opacity: 0.9;
  margin-top: 4rpx;
}

.spine-title {
  margin-top: auto;
  font-family: "Noto Serif SC", "Cormorant Garamond", "Songti SC", serif;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-align: center;
  line-height: 1.3;
}

.body {
  flex: 1;
  min-width: 0;
  padding: 28rpx 28rpx 28rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.body-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.title {
  font-family: "Noto Serif SC", "Cormorant Garamond", "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #1f1b16;
  line-height: 1.3;
  flex: 1;
  min-width: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.more {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex-shrink: 0;
  margin: -8rpx -12rpx 0 0;
  border-radius: 8rpx;
}

.more--hover {
  background: rgba(31, 27, 22, 0.06);
}

.more-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #6b6359;
  flex-shrink: 0;
}

.author {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.synopsis {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #3a3530;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meta {
  margin-top: auto;
  padding-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 20rpx;
}
