<view class="card" bindtap="onOpen">
  <view
    class="spine"
    style="background: linear-gradient(160deg, {{palette.primary}} 0%, {{palette.deep}} 100%); color: {{palette.text}};"
  >
    <image
      wx:if="{{novel.cover && !coverFailed}}"
      class="spine-cover"
      src="{{novel.cover}}"
      mode="aspectFill"
      binderror="onCoverError"
    />
    <text wx:if="{{!novel.cover || coverFailed}}" class="spine-vol">Vol.</text>
    <text wx:if="{{!novel.cover || coverFailed}}" class="spine-num">{{vol}}</text>
    <text wx:if="{{!novel.cover || coverFailed}}" class="spine-title">{{shortTitle}}</text>
  </view>
  <view class="body">
    <view class="body-top">
      <view class="title">{{novel.title}}</view>
      <view class="more" catchtap="onMore" hover-class="more--hover">
        <view class="more-dot"></view>
        <view class="more-dot"></view>
        <view class="more-dot"></view>
      </view>
    </view>
    <view class="author muted">{{novel.author || '佚名'}}</view>
    <view wx:if="{{novel.synopsis}}" class="synopsis">{{novel.synopsis}}</view>
    <view class="meta">
      <text class="muted">{{charCount}} 人 · {{relCount}} 缘</text>
      <text class="muted">{{timeLabel}}</text>
    </view>
  </view>
</view>
