/* 墨缘设计 token — 对齐 H5 Tailwind 主题 */
page {
  --paper: #f5efe2;
  --paper-deep: #ebe3d2;
  --paper-soft: #faf6ec;
  --ink: #1f1b16;
  --ink-soft: #3a3530;
  --ink-mute: #6b6359;
  --ink-wash: #a39a8b;
  --vermillion: #a8322d;
  --vermillion-deep: #7a2420;
  --gold: #a3824a;
  --moss: #5b6b4a;
  background: var(--paper-soft);
  color: var(--ink);
  font-family: "Noto Sans SC", system-ui, "PingFang SC", "Helvetica Neue",
    sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

.font-display {
  font-family: "Cormorant Garamond", "Noto Serif SC", Georgia, serif;
}

.font-song {
  font-family: "Noto Serif SC", "Cormorant Garamond", "Songti SC", serif;
}

.font-brush {
  font-family: "Ma Shan Zheng", "Noto Serif SC", serif;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 80rpx;
  padding: 0 28rpx;
  background: #a8322d;
  color: #faf6ec;
  border-radius: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
  box-shadow: 0 0 0 1rpx rgba(168, 50, 45, 0.2),
    0 12rpx 36rpx -12rpx rgba(168, 50, 45, 0.32);
}

.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 28rpx;
  background: transparent;
  color: #1f1b16;
  border: 1rpx solid rgba(31, 27, 22, 0.15);
  border-radius: 4rpx;
  font-size: 26rpx;
  letter-spacing: 0.04em;
}

.field-line {
  width: 100%;
  padding: 16rpx 0;
  border: none;
  border-bottom: 1rpx solid rgba(31, 27, 22, 0.2);
  background: transparent;
  font-family: "Noto Sans SC", system-ui, "PingFang SC", sans-serif;
  font-size: 28rpx;
  color: #1f1b16;
}

.field-label {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: #6b6359;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}

.paper-card {
  background: var(--paper-soft);
  border: 1rpx solid rgba(31, 27, 22, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 0 rgba(31, 27, 22, 0.04),
    0 16rpx 48rpx -24rpx rgba(31, 27, 22, 0.18);
}

.muted {
  color: var(--ink-mute);
}

.safe-top {
  padding-top: env(safe-area-inset-top);
}
