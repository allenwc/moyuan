{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@moyuan/core": ["./packages/core/src/index.ts"],
      "@moyuan/cloudbase": ["./packages/cloudbase/src/index.ts"]
    }
  },
  "include": ["./cloudfunctions/api/src", "./packages", "./cli/src"],
  "exclude": ["node_modules", "dist", "h5", "weapp", "site"]
}
