# ============ CloudBase ============
CLOUDBASE_ENV_ID=your-env-id
CLOUDBASE_SECRET_ID=your-secret-id
CLOUDBASE_SECRET_KEY=your-secret-key

# ============ 自建会话鉴权（REST API） ============
MOYUAN_JWT_SECRET=change-me-strong-secret
MOYUAN_ALLOW_DEV_LOGIN=false

# ============ 微信（云函数 signInWithWeChat 使用） ============
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# ============ H5（Vite，读仓库根目录 .env.local） ============
VITE_CLOUDBASE_ENV_ID=your-env-id
